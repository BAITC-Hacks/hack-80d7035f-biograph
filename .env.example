# Local n8n + PostgreSQL/pgvector setup
POSTGRES_DB=ekt_assistant
POSTGRES_USER=ekt_user
POSTGRES_PASSWORD=change-me-to-a-long-unique-password
POSTGRES_PORT=5432

N8N_HOST=localhost
N8N_PORT=5678
# Generate a random, persistent value. Changing it makes saved n8n credentials unreadable.
N8N_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-secret
