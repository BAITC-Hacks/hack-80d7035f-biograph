        "jsCode": "const items = $input.all().map(item => item.json);\nconst root = items.length === 1 ? items[0] : items;\nconst isRecord = value => value !== null && typeof value === 'object' && !Array.isArray(value);\nconst keys = isRecord(root) ? Object.keys(root) : [];\nconst arrayKeys = isRecord(root) ? keys.filter(key => Array.isArray(root[key])) : [];\nconst candidate = Array.isArray(root) ? root : (root.products ?? root.items ?? root.data ?? root.results ?? []);\nconst records = Array.isArray(candidate) ? candidate : (Array.isArray(candidate.items) ? candidate.items : []);\nreturn [{ json: { topLevelType: Array.isArray(root) ? 'array' : typeof root, topLevelKeys: keys, arrayKeys, recordCount: records.length, sample: records.slice(0, 2), pagination: isRecord(root) ? { page: root.page ?? null, pages: root.pages ?? root.total_pages ?? null, next: root.next ?? null } : null } }];"
